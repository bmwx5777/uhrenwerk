{$DOMAIN} {
	encode zstd gzip

	# Фото, загруженные из админки, лежат в томе и появляются после сборки,
	# поэтому отдаём их напрямую, а не через Next.
	handle /uploads/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}

# www → основной домен
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
