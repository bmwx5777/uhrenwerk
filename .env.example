# ---------------------------------------------------------------
# Этап 1 — базовое приложение
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Этап 2 — база данных (локальный Postgres из docker-compose.yml)
# ---------------------------------------------------------------
DATABASE_URL="postgresql://uhrenwerk:uhrenwerk_local@localhost:5432/uhrenwerk"

# ---------------------------------------------------------------
# Этап 5 — аутентификация
# ---------------------------------------------------------------
# Сгенерировать новый: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------
# Этап 8 — письма, задачи по расписанию, банковские реквизиты
# ---------------------------------------------------------------
# Без ключа письма печатаются в консоль сервера (работает только в dev).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="UHRENWERK <orders@uhrenwerk.example>"

# Секрет для /api/cron/release-reservations: openssl rand -hex 24
# CRON_SECRET=""

# Реквизиты для проформы при оплате банковским переводом.
# BANK_BENEFICIARY="UHRENWERK LTD"
# BANK_IBAN="CY00 0000 0000 0000 0000 0000 0000"
# BANK_BIC="BCYPCY2N"
# BANK_NAME="Bank of Cyprus"
