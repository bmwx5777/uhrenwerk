# Скопировать в .env.production на сервере и заполнить.
# Файл .env.production в git не попадает.

# Домен без https:// — на него должна указывать A-запись DNS.
DOMAIN="uhrenwerk.example"

# openssl rand -base64 24
POSTGRES_PASSWORD=""

# openssl rand -base64 32 — задаётся один раз, смена разлогинит всех.
BETTER_AUTH_SECRET=""

# openssl rand -hex 24
CRON_SECRET=""

# Письма (сброс пароля, подтверждение, заказы). Без ключа в production
# отправка падает. Домен отправителя подтвердить в панели Resend.
RESEND_API_KEY=""
EMAIL_FROM="UHRENWERK <orders@uhrenwerk.example>"

# Реквизиты для оплаты банковским переводом.
BANK_BENEFICIARY=""
BANK_IBAN=""
BANK_BIC=""
BANK_NAME=""
